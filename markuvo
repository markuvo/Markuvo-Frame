/*
|--------------------------------------------------------------------------
| Argümanlar:  php markuvo <komut> [argüman] [--secenek=deger] [--bayrak]
|--------------------------------------------------------------------------
*/
$argv = $_SERVER['argv'] ?? [];
array_shift($argv);

$command = 'help';
$positional = [];
$options = [];

foreach ($argv as $arg) {
    if (str_starts_with($arg, '--')) {
        $pair = explode('=', substr($arg, 2), 2);
        $options[$pair[0]] = $pair[1] ?? true;
    } elseif ($command === 'help' && $positional === [] && !isset($commandSet)) {
        $command = $arg;
        $commandSet = true;
    } else {
        $positional[] = $arg;
    }
}
$argument = $positional[0] ?? null;

