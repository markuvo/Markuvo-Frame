$WHITE  = "\033[97m";
$BOLD   = "\033[1m";

function line($char = '─', $length = 58) { echo str_repeat($char, $length) . PHP_EOL; }
function success($message) { global $GREEN, $RESET; echo "{$GREEN}✓ {$message}{$RESET}" . PHP_EOL; }
function errorMessage($message) { global $RED, $RESET; echo "{$RED}✗ {$message}{$RESET}" . PHP_EOL; }
function warning($message) { global $YELLOW, $RESET; echo "{$YELLOW}! {$message}{$RESET}" . PHP_EOL; }
function info($message) { global $CYAN, $RESET; echo "{$CYAN}› {$message}{$RESET}" . PHP_EOL; }

/** Uygulamayı konsol modunda başlatır (.env + config yüklenir, veritabanı ilk sorguda bağlanır). */
function bootApp(): Application
{
    static $app = null;

    return $app ??= Application::boot(__DIR__, ['console' => true]);
}

/** Dosya/sınıf adı güvenliği: yalnızca harf, rakam, alt çizgi ve (alt klasör için) eğik çizgi. */
function safeName(?string $name, string $what): string
{
    if (!$name) {
        errorMessage("{$what} adı belirtmelisiniz.");
        exit(1);
    }
    if (!preg_match('#^[A-Za-z][A-Za-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)*$#', $name)) {
        errorMessage("Geçersiz {$what} adı: yalnızca harf, rakam ve _ kullanın (alt klasör için /).");
        exit(1);
    }

    return $name;
}

/** "Admin/Panel" -> [ "Admin", "Panel" ] (isim alanı soneki, sınıf adı) */
function splitName(string $name): array
{
    $parts = explode('/', $name);
    $class = ucfirst(array_pop($parts));

    return [array_map('ucfirst', $parts), $class];
}

function writeStub(string $directory, array $subDirs, string $class, string $contents, string $label): void
{
    $dir = $directory . ($subDirs ? '/' . implode('/', $subDirs) : '');
    $file = $dir . '/' . $class . '.php';

    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
    if (file_exists($file)) {
        warning("{$class} zaten mevcut.");
        exit(0);
    }

    file_put_contents($file, $contents);
    success("{$label} başarıyla oluşturuldu.");
    echo "  File: {$file}" . PHP_EOL . PHP_EOL;
}

