APP_NAME=Markuvo
# Canlıda mutlaka false olmalı (true iken hata ayrıntıları ekranda görünür)
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul

# --- Veritabanı: mysql | mariadb | pgsql | sqlite ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=markuvo
DB_USERNAME=root
DB_PASSWORD=

# SQLite hızlı başlangıç (sunucu kurmadan): DB_CONNECTION=sqlite  ve  DB_DATABASE=database/database.sqlite
#   sonra:  php markuvo migrate && php markuvo db:seed

# --- Önbellek: file | array | redis ---
CACHE_DRIVER=file
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Günlük ---
LOG_LEVEL=debug
LOG_DAILY=false

# --- Gerçek veritabanı testi (isteğe bağlı) ---
# Asıl DB_DATABASE'den FARKLI, boş bir test veritabanı açın; test içindeki tabloları siler!
# Çalıştırma: php markuvo test Real
# TEST_DB=mysql
# TEST_DB_DATABASE=markuvo_test
